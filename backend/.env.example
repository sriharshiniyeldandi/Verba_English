# Backen
DATABASE_URL=
JWT_SECRET=
JWT_ALGORITHM=HS256
CORS_ORIGINS=https://verba-spokenenglishassistant.onrender.com,https://verba-frontend.onrender.com,http://localhost:3000
# Timezone used for streak/calendar day boundaries (any IANA name, e.g. Asia/Kolkata, Europe/London, UTC).
APP_TIMEZONE=Asia/Kolkata
STORAGE_PROVIDER=cloudinary
# groq = Whisper speech-to-text via Groq (needs GROQ_API_KEY). unconfigured = analysis disabled.
SPEECH_PROVIDER=groq
GROQ_API_KEY=
GROQ_STT_MODEL=whisper-large-v3-turbo
# Language analysis model: groq (default, reuses GROQ_API_KEY) | huggingface (needs HF_TOKEN + AI_ANALYSIS_MODEL) | openai_compatible (needs AI_ANALYSIS_BASE_URL + AI_ANALYSIS_MODEL).
AI_ANALYSIS_PROVIDER=groq
# Blank = the provider default (Groq: openai/gpt-oss-120b). Hosted free models get retired; if one disappears, change it here.
AI_ANALYSIS_MODEL=openai/gpt-oss-120b
HF_TOKEN=
AI_ANALYSIS_BASE_URL=
AI_ANALYSIS_API_KEY=
# A video/podcast counts as completed once a teacher's player reports at least this percentage (1-100). Default 90.
COMPLETION_THRESHOLD_PERCENT=90
MAX_UPLOAD_SIZE_MB=50
# Needed only to let someone self-register as an admin (they must enter this code). Leave empty to disable admin sign-up.
ADMIN_INVITE_CODE=VerbaAdmin@2026
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Minimum normalized transcript-vs-reference-script similarity (0-1) to accept a practice attempt.
SCRIPT_MATCH_THRESHOLD=0.70
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=Verba:Spoken English
# Frontend
NEXT_PUBLIC_API_URL=https://verba-english-9.onrender.com
